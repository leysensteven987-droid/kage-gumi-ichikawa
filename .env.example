# Ichikawa 市川 — environment. Copy to `.env` (gitignored) and fill in.
#
# BOTH vars are optional. Leaving LOCK_PASSPHRASE unset makes the passphrase gate
# a no-op pass-through, which is the normal setup for local development — you get
# the app straight away with no unlock page. Set them only on a host that is
# actually exposed (the box behind the Cloudflare Tunnel).

# Shared unlock passphrase for the gate in server/lock.mjs. UNSET ⇒ gate disabled.
LOCK_PASSPHRASE=

# HMAC key signing the session cookie. Only read when LOCK_PASSPHRASE is set; if
# the passphrase is set and this is not, unlocking fails with a 500 by design.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCK_SESSION_SECRET=

# Port for the Express server (server/index.js). Defaults to 5273.
#ICHIKAWA_PORT=5273
